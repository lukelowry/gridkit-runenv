{
  "name": "GridKit Studio Runtime",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--pull"],
    "args": {
      "RUNTIME_PLATFORM": "linux/amd64"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "gridkit.installPrefix": "/opt/gridkit"
      }
    }
  },
  "postCreateCommand": "test -x /opt/gridkit/bin/DynamicSimulation",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}
